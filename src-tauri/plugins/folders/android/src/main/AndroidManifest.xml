<?xml version="1.0" encoding="utf-8"?>
<!-- Readlet reads the books folder with ordinary file APIs, so it needs access to shared storage:
     "All files access" from Android 11, the storage permissions before that. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 10 alone needs this to read shared storage by path. -->
    <application android:requestLegacyExternalStorage="true" />
</manifest>

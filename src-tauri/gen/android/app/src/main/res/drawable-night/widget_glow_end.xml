<?xml version="1.0" encoding="utf-8"?>
<!-- The book's second colour, a little stronger at night. White, so the book's colour can be laid over it (Widgets.paintAura). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#00FFFFFF"
        android:centerColor="#00FFFFFF"
        android:centerX="0.35"
        android:endColor="#6BFFFFFF"
        android:type="linear" />
    <corners android:radius="@dimen/widget_radius" />
</shape>

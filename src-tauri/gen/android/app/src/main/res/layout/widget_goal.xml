<?xml version="1.0" encoding="utf-8"?>
<!-- Reading goal: today's minutes in a ring against the daily goal, and the streak below. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_surface"
    android:clipToOutline="true">

    <!-- The book's colours, fading in from either side (Widgets.paintAura). -->
    <ImageView
        android:id="@+id/glowStart"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow_start" />

    <ImageView
        android:id="@+id/glowEnd"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_glow_end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="12dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp">

            <ProgressBar
                android:id="@+id/ring"
                style="@style/ReadletWidgetProgress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="64dp"
                android:maxHeight="64dp"
                android:progress="400"
                android:progressDrawable="@drawable/widget_ring" />

            <TextView
                android:id="@+id/minutes"
                style="@style/ReadletWidgetTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:text="12"
                android:textSize="19sp"
                android:textStyle="normal" />
        </FrameLayout>

        <TextView
            android:id="@+id/summary"
            style="@style/ReadletWidgetText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="of 30 min today"
            android:textColor="@color/widget_ink" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/flame"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_flame" />

            <TextView
                android:id="@+id/streak"
                style="@style/ReadletWidgetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 days" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
